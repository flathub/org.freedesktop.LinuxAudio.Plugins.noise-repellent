{
    "id": "org.freedesktop.LinuxAudio.Plugins.noise-repellent",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//26.08",
    "build-extension": true,
    "branch": "26.08",
    "build-options": {
        "prefix": "/app/extensions/Plugins/noise-repellent",
        "prepend-pkg-config-path": "/app/extensions/Plugins/noise-repellent/lib/pkgconfig"
    },
    "cleanup": [
        "/bin",
        "/include",
        "/lib",
        "/pkgconfig",
        "*.a"
    ],
    "modules": [
        "shared-modules/linux-audio/lv2.json",
        "shared-modules/linux-audio/fftw3f-static.json",
        {
            "name": "noise-repellent",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DENABLE_AVX=ON",
                "-DUSE_SYSTEM_FREETYPE=ON",
                "-DUSE_SYSTEM_FFTW=ON",
                "-DFETCHCONTENT_FULLY_DISCONNECTED=ON",
                "-DSPECBLEACH_INSTALL=OFF",
                "-DBUILD_SHARED_LIBS=OFF"
            ],
            "no-make-install": true,
            "post-install": [
                "install -d ${FLATPAK_DEST}/lv2 ${FLATPAK_DEST}/vst3",
                "cp -R NoiseRepellent_artefacts/Release/LV2/Noise\\ Repellent.lv2 ${FLATPAK_DEST}/lv2/",
                "strip ${FLATPAK_DEST}/lv2/Noise\\ Repellent.lv2/libNoise\\ Repellent.so",
                "cp -R NoiseRepellent_artefacts/Release/VST3/Noise\\ Repellent.vst3 ${FLATPAK_DEST}/vst3/",
                "strip ${FLATPAK_DEST}/vst3/Noise\\ Repellent.vst3/Contents/*64-linux/Noise\\ Repellent.so",
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.noise-repellent.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/lucianodato/noise-repellent/archive/refs/tags/v0.3.2.tar.gz",
                    "sha256": "a741b94a51a22de9f4b135b1d6efc00c39e43e9e25278b9360caa254cb861398"
                },
                {
                    "type": "git",
                    "url": "https://github.com/juce-framework/JUCE.git",
                    "tag": "8.0.4",
                    "commit": "51d11a2be6d5c97ccf12b4e5e827006e19f0555a",
                    "dest": "_deps/juce-src"
                },
                {
                    "type": "git",
                    "url": "https://github.com/lucianodato/libspecbleach.git",
                    "tag": "v0.3.1",
                    "commit": "580c05e7b64015c041ed00af554ffdd5ee640c79",
                    "dest": "subprojects/libspecbleach"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.noise-repellent.metainfo.xml"
                }
            ]
        }
    ]
}
